# ============================================================
# gruporubio-web — Variables de producción
# Copiar a .env.web en el VPS y rellenar los valores
# ============================================================

# Medusa backend (en el mismo VPS)
NEXT_PUBLIC_MEDUSA_URL=https://api.gruporubio.es
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_REGION_ID=

# Stripe (usar claves de PRODUCCIÓN, no test)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...

# PayPal (mismo Client ID que en .env.medusa, no el secret)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Chatbot Ignacio
ANTHROPIC_API_KEY=

# Email (formularios de contacto y presupuesto)
SMTP_HOST=smtp.gruporubio.net
SMTP_PORT=587
SMTP_USER=administracion@gruporubio.net
SMTP_PASS=
CONTACT_EMAIL=administracion@gruporubio.net

# URL base de la web
NEXT_PUBLIC_SITE_URL=https://gruporubio.es

# Meilisearch (buscador tienda/hero)
# Host público al que llega el navegador (mientras la web esté en Vercel: http://IP_VPS:7700)
NEXT_PUBLIC_MEILISEARCH_HOST=
# API key de SOLO BÚSQUEDA (crear con POST /keys usando la master key; nunca la master aquí)
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=
# Key admin/master — solo para el script scripts/sync-search-content.ts (npm run search:sync-content)
MEILISEARCH_ADMIN_KEY=

# Sentry (monitorización de errores) — inactivo si el DSN está vacío
NEXT_PUBLIC_SENTRY_DSN=
# Solo para subir sourcemaps en el build (opcional)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
